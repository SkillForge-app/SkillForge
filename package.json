{
  "name": "skillforge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @skillforge/web",
    "build": "npm run build --workspace @skillforge/web",
    "start": "npm run start --workspace @skillforge/web",
    "lint": "npm run lint --workspace @skillforge/web",
    "typecheck": "npm run typecheck --workspace @skillforge/web",
    "api:generate": "openapi-typescript openapi/openapi.json -o apps/web/lib/api/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- apps/web/lib/api/schema.d.ts",
    "format": "prettier --write \"apps/web/app/**/*.{ts,tsx,css,md}\" \"apps/web/components/**/*.{ts,tsx,css}\" \"apps/web/lib/**/*.{ts,tsx}\" \"apps/web/*.{json,ts,tsx,md}\" \"docs/frontend/*.md\" \"*.{json,md}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"apps/web/app/**/*.{ts,tsx,css,md}\" \"apps/web/components/**/*.{ts,tsx,css}\" \"apps/web/lib/**/*.{ts,tsx}\" \"apps/web/*.{json,ts,tsx,md}\" \"docs/frontend/*.md\" \"*.{json,md}\" \".github/workflows/*.yml\""
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
