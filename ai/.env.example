# Copy to ai/.env (gitignored) and fill in. Real environment variables win over this file.
# Never put a real key in this file: it is committed to git.

# Claude models via OpenRouter (all Claude roles in core/llm/models.yaml)
OPENROUTER_API_KEY=
# Only if you switch a role to the direct Anthropic API (the `# direct:` lines in models.yaml)
ANTHROPIC_API_KEY=
# Only if you switch the embedding role to the hosted OpenAI model (the default is a local
# model that needs no key: see core/llm/models.yaml)
OPENAI_API_KEY=

# The AI services' environment (AI-21): dev (default), staging or production. It sets defaults
# for the backends below and the cost and rate limits; see docs/ai/production-config.md.
# SKILLFORGE_ENV=dev

# litellm (default) or fake (no network, canned outputs)
# SKILLFORGE_LLM_BACKEND=litellm

# Switch one role's model without editing core/llm/models.yaml
# SKILLFORGE_MODEL_EXTRACTION=anthropic/claude-haiku-5-5   (direct Anthropic instead of OpenRouter)
