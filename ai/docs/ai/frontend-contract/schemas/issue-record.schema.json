{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "path": {
      "title": "Path",
      "type": "string"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "severity": {
      "default": "error",
      "enum": [
        "error",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "required": [
    "path",
    "code",
    "message"
  ],
  "title": "IssueRecord",
  "type": "object"
}
