# Settings for the local stack (compose.yaml, OPS-03). Copy this file to .env (gitignored):
#   cp .env.example .env
# LOCAL DEVELOPMENT ONLY. These are placeholders for a database on your own machine, reachable
# only from 127.0.0.1. Never use them for staging or production.
# The database values match the DATABASE_URL in data/.env.example.

POSTGRES_PASSWORD=skillforge_dev
POSTGRES_PORT=5433
REDIS_PORT=6379

# Web app (docker compose --profile web up -d --build)
WEB_PORT=3000
# The API URL the BROWSER calls, baked in at build time: rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
