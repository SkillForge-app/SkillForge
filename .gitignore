# Repo-wide safety net. Each department folder keeps its own .gitignore for its tools.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Environments and caches
.venv/
venv/
__pycache__/
node_modules/

# ai/ local files: ignored on every branch, not only AI (ai/.gitignore exists only where ai/ is checked in)
ai/.data/
ai/.venv/
ai/.env

# OS files
.DS_Store
Thumbs.db
