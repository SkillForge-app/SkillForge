# Repo-wide safety net. Department folders keep local tool rules in their own .gitignore.

# Secrets
.env*
!.env.example
*.pem
*.key

# Node/frontend outputs
node_modules/
.next/
out/
build/
coverage/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python environments and caches
.venv/
venv/
__pycache__/

# AI local files
ai/.data/
ai/.venv/
ai/.env

# OS files
.DS_Store
Thumbs.db